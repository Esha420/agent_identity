# Cerbos Configuration
CERBOS_HTTP_URL=http://localhost:3592
CERBOS_GRPC_URL=localhost:3593

# Auth0 OIDC Configuration (Identity Provider Layer)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_ISSUER=https://your-tenant.us.auth0.com/
AUTH0_AUDIENCE=https://agent-admission.example.com
AUTH0_CLIENT_ID=your_client_id_here
AUTH0_ALLOWED_ALGORITHMS=RS256
AUTH0_REQUIRED_SCOPES=agent:execute
AUTH0_ORG_ID=org_demo
# Note: For public SPA or native clients using PKCE, no client secret is used.
# For confidential M2M orchestrator backend callers, set AUTH0_CLIENT_SECRET in secret manager.

# AX & Substrate Configuration
AX_BIN=./bin/ax
AX_NAMESPACE=ax-system
AX_ATESPACE=default

# Target Web Server for Testing
MOCK_TARGET_URL=http://mock-target:8089
